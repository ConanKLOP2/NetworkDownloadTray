<Window x:Class="NetworkDownloadTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Download Tray" Width="1100" Height="760" MinWidth="800" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#0B1220" FontFamily="Segoe UI"
        Foreground="#F1F5F9" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CBD5E1"/></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,24,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E3A50"/><Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7DD3FC"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="#7DD3FC"/>
            <Setter Property="Padding" Value="10,9"/><Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,4"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#164E63"/><Setter Property="Foreground" Value="White"/>
            </Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Border DockPanel.Dock="Right" Background="#123B36" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="LiveText" Text="STARTING" Foreground="#6EE7B7" FontWeight="SemiBold"/>
            </Border>
            <StackPanel><TextBlock Text="Network Download" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Download only · real-time Mbps" Margin="0,4,0,0" Foreground="#94A3B8"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#111C2E" BorderBrush="#263750" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="DOWNLOAD SPEED" Foreground="#7DD3FC" HorizontalAlignment="Center" FontSize="11"/>
                <TextBlock x:Name="SpeedText" Text="Measuring..." Foreground="White" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AdapterText" Text="Reading adapters" TextWrapping="Wrap" TextAlignment="Center" Foreground="#94A3B8"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" x:Name="DiagnosticsPanel" Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="AdapterFilterBox" Width="135" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All adapters"/><ComboBoxItem Content="Included"/><ComboBoxItem Content="Excluded"/>
                    </ComboBox>
                    <Button Content="Refresh" Click="Refresh_Click"/><Button Content="Copy selected" Click="CopyAdapter_Click"/>
                </StackPanel>
                <TextBlock x:Name="AdapterCountText" Text="ADAPTER DIAGNOSTICS" VerticalAlignment="Center" Foreground="#7DD3FC"/>
            </DockPanel>
            <DataGrid x:Name="AdapterGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" Background="#0B1424" Foreground="#CBD5E1"
                      RowBackground="#111C2E" AlternatingRowBackground="#152236" BorderBrush="#263750"
                      HorizontalGridLinesBrush="#263750" GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="30" FontSize="12">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Included" Binding="{Binding Included, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="145"/>
                    <DataGridTextColumn Header="Mode" Binding="{Binding SelectionMode}" Width="90"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="125"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="240"/>
                    <DataGridTextColumn Header="Received bytes" Binding="{Binding BytesReceived, StringFormat=N0}" Width="145"/>
                    <DataGridTextColumn Header="Reason" Binding="{Binding ExclusionReason}" Width="240"/>
                    <DataGridTextColumn Header="Adapter ID" Binding="{Binding Id}" Width="285"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Margin="0,7,0,0" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"
                       Text="Right-click an adapter: Include / Exclude / Automatic. Automatic virtual detection is a heuristic; use Include only for the intended interface."/>
        </Grid>
        <Border Grid.Row="3" Background="#111C2E" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="AutoStartCheckBox" Content="Start with Windows" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized to tray" Checked="Minimized_Changed" Unchecked="Minimized_Changed"/>
                    <CheckBox x:Name="DiagnosticsCheckBox" Content="Show adapter diagnostics" Checked="Diagnostics_Changed" Unchecked="Diagnostics_Changed"/>
                </WrapPanel>
                <TextBlock x:Name="StartupPathText" Margin="0,6,0,0" Foreground="#94A3B8" FontSize="11"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Minimize to Tray" Click="MinimizeToTray_Click"/>
                <Button Content="Exit" Background="#0E7490" Click="Exit_Click"/>
            </StackPanel>
            <TextBlock x:Name="TrayStatusText" Text="Waiting for tray" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
